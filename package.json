{
  "name": "dovecote",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:secrets": "./scripts/setup-worker-vars.sh",
    "deploy:verify": "bun test --path-ignore-patterns \"\" test/e2e/smoke.test.ts",
    "test": "bun test",
    "test:e2e": "bun test --path-ignore-patterns \"\" test/e2e/",
    "test:e2e:remote": "bun test --path-ignore-patterns \"\" test/e2e",
    "test:integration:build": "wrangler deploy --dry-run --outdir dist-test",
    "test:integration": "bun test --path-ignore-patterns \"\" test/integration/",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "mutation": "bunx stryker run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260410.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "latest",
    "fast-check": "^4.7.0",
    "lefthook": "^2.1.6",
    "miniflare": "^4.20260409.0",
    "wrangler": "^4.81.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.12",
    "zod": "^3.24.1"
  },
  "overrides": {
    "zod": "3.25.76"
  }
}
