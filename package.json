{
  "name": "dovecote",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:secrets": "./scripts/setup-worker-vars.sh",
    "deploy:verify": "bun test --path-ignore-patterns \"\" test/e2e/smoke.test.ts",
    "test": "bun test",
    "test:e2e": "bun test --path-ignore-patterns \"\" test/e2e/",
    "test:e2e:remote": "bun test --path-ignore-patterns \"\" test/e2e",
    "test:integration:build": "wrangler deploy --dry-run --outdir dist-test",
    "test:integration": "bun test --path-ignore-patterns \"\" test/integration/",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "mutation": "bunx stryker run",
    "openapi:gen": "bun scripts/generate-openapi.mjs",
    "setup": "bun scripts/setup-wizard.ts",
    "verify": "bun scripts/verify.ts",
    "channel:add": "bun scripts/channel-add.ts",
    "channel:migrate": "bun scripts/channel-migrate.ts"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@cloudflare/workers-types": "^4.20260410.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "latest",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.157.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "jose": "^6.2.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "jose": "6.2.2",
    "zod": "3.25.76"
  }
}
