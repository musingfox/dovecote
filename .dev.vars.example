# HMAC pepper for API token hashing (generate with: openssl rand -base64 32)
HMAC_PEPPER=your-32-character-hmac-pepper-here

# Notification channels are NOT env vars. Each channel is a
# `channel:<service>-<id>` record in the OAUTH_KV namespace; add one with
# `bun run channel:add -- --env <staging|production>`.
