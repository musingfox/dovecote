# MCP Server Authentication Token (legacy bearer auth)
MCP_AUTH_TOKEN=your-secure-token-here

# OAuth Password for authorization flow
OAUTH_PASSWORD=changeme

# Cookie encryption key (generate with: openssl rand -base64 32)
COOKIE_ENCRYPTION_KEY=

# Telegram Instances (JSON array)
# Each instance must have: id (lowercase alphanumeric with dashes), botToken, chatId
TELEGRAM_INSTANCES=[{"id":"default","botToken":"123456789:ABCdefGHIjklMNOpqrsTUVwxyz","chatId":"123456789"}]

# Discord Instances (JSON array)
# Each instance must have: id (lowercase alphanumeric with dashes), webhookUrl
DISCORD_INSTANCES=[{"id":"default","webhookUrl":"https://discord.com/api/webhooks/123456789/abcdefghijklmnopqrstuvwxyz"}]

# Multiple instances example:
# TELEGRAM_INSTANCES=[{"id":"alerts","botToken":"...","chatId":"..."},{"id":"team-a","botToken":"...","chatId":"..."}]
# DISCORD_INSTANCES=[{"id":"general","webhookUrl":"..."},{"id":"team-b","webhookUrl":"..."}]
