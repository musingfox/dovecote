                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Admin token revocation pressure circuit open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/exchange-oidc": {
      "post": {
        "description": "Exchange an OIDC id_token (from an allow-listed issuer) for a dvct_* runtime token. New subjects are auto-provisioned with scope `dovecote:notify`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeOidcRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenIssueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request body failed zod validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "id_token failed verification (untrusted_issuer / bad_signature / bad_audience / expired_token / iat_skew / malformed_token / untrusted_subject)",
